# ─────────────────────────────────────────────────────────────────────────────
# .env.production — Variables para el container en producción
# Copiar a /opt/clinica/.env.production en el Droplet y completar los valores.
# NUNCA subir este archivo con valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Base de datos PostgreSQL (en el host, no en container)
DATABASE_URL=postgresql://clinica_user:CONTRASEÑA_SEGURA@host.docker.internal:5432/clinica_db

# JWT — mínimo 32 caracteres aleatorios (generar con: openssl rand -hex 32)
JWT_SECRET=REEMPLAZAR_CON_SECRET_SEGURO_32_CHARS_MINIMO
JWT_EXPIRES_IN=30m
JWT_EXPIRES_IN_MOBILE=never

# SMTP — para emails de confirmación de citas (RF-22)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=notificaciones@clinica.gt
SMTP_PASS=CONTRASEÑA_SMTP
SMTP_FROM="Clínica Médica <notificaciones@clinica.gt>"

# DigitalOcean Spaces — para backups y documentos adjuntos
DO_SPACES_KEY=TU_SPACES_ACCESS_KEY
DO_SPACES_SECRET=TU_SPACES_SECRET_KEY
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=clinica-backups
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Puerto del servidor (no cambiar si usas el docker-compose.prod.yml)
PORT=3000
